1d93ac217b134afdc544ffe/a3fa1/valvoline.png 350w,\n/static/18af014f01d93ac217b134afdc544ffe/bc3b9/valvoline.png 700w","sizes":"(min-width: 700px) 700px, 100vw"},"sources":[{"srcSet":"/static/18af014f01d93ac217b134afdc544ffe/dae43/valvoline.avif 175w,\n/static/18af014f01d93ac217b134afdc544ffe/d7667/valvoline.avif 350w,\n/static/18af014f01d93ac217b134afdc544ffe/7ec1a/valvoline.avif 700w","type":"image/avif","sizes":"(min-width: 700px) 700px, 100vw"},{"srcSet":"/static/18af014f01d93ac217b134afdc544ffe/5d873/valvoline.webp 175w,\n/static/18af014f01d93ac217b134afdc544ffe/26a00/valvoline.webp 350w,\n/static/18af014f01d93ac217b134afdc544ffe/f23f0/valvoline.webp 700w","type":"image/webp","sizes":"(min-width: 700px) 700px, 100vw"}]},"width":700,"height":394}}},"tech":["Java","Python","API Design","Data Pipelines"],"github":null,"external":"https://www.valvoline.com/","cta":"https://www.valvoline.com/","caseStudy":"/work/valvoline"},"html":"<p>At Valvoline, I built features for a vehicle-based product recommendation and service platform used for maintenance and product selection workflows.\nI developed backend services in Java and Python for compatibility logic, product lookup, and recommendation experiences across a broad automotive catalog.\nI also helped automate ingestion and validation of vehicle and product datasets, improving reliability for customer-facing and service-facing applications.</p>"}}]}}}